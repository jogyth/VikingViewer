# Kopier til .env og fyll inn lokal pålogging. Node.js 22 eller nyere.
# Miljøvariabler overstyrer verdiene i .env.
VIKING_USERNAME=
VIKING_PASSWORD=

# Maskinnavn blir slave1 til slave8, med to baner per maskin.
VIKING_HOST_PREFIX=slave
VIKING_SHARE=c$
# Åtte ulike diskbokstaver, i rekkefølge for baner 1–16.
VIKING_DRIVES=O,P,Q,R,S,T,U,V
# Relativ mappe under hver nettverksdisk.
VIKING_IMAGE_DIR=Viking2001\GameCtrl

# Bruk doble anførselstegn rundt verdier med # eller mellomrom.
